# The API the app talks to.
#
# Copy this file to `.env` and change what you need. Every value has a
# default, so the app runs with no `.env` at all.

# Whether the app answers from the local mock instead of the Java service.
#
# The mock is on by default, so `npm run dev` works without a database. It
# answers with fixture data and a sign-in that accepts any code, so a
# production build refuses to run with it on.
#
#   VITE_USE_MOCK=true   the mock answers — for development
#   VITE_USE_MOCK=false  the Java service answers — for anything real
VITE_USE_MOCK=true

# Where the Java service is, when the app is not served from the same host.
# In production this is a relative "/api", which is the default.
# VITE_API_URL=/api

# Where the dev server proxies /api to. Only used by `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8080

# ---------------------------------------------------------------------------
# The compose stack
#
# `docker compose up --build` reads these. The Java service's own fifteen
# variables live in `backend/.env.example` — that file is the service's
# contract, and this one is the stack's.
# ---------------------------------------------------------------------------

# Where Postgres listens inside the compose network.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medmate_clinic_api
POSTGRES_USER=medmate
POSTGRES_PASSWORD=medmate

# The port the compose stack publishes Postgres on.
POSTGRES_PUBLISHED_PORT=5432

# The port the compose stack publishes the API on.
API_PUBLISHED_PORT=8080

# The port the compose stack publishes the web app on.
WEB_PUBLISHED_PORT=3100

# The origins the API accepts the browser from. The web app's origin has to
# be in this list or every request from the browser is refused by CORS.
# The service reads CORS_ALLOWED_ORIGINS; CORS_ORIGINS is the older name and
# is still read as a fallback.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# The slug the kiosk opens for the clinic it belongs to.
KIOSK_CLINIC_SLUG=medmate-clinic

# The development clinic the service seeds with people, patients and a queue.
# It is the clinic the E2E suite signs in to.
DEMO_ENABLED=true
DEMO_CLINIC_ID=11111111-1111-4111-8111-111111111111
