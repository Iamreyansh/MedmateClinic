# The API the app talks to.
#
# Copy this file to `.env` and change what you need. Every value has a
# default, so the app runs with no `.env` at all.

# Whether the app answers from the local mock instead of the Java service.
#
# The mock is on by default, so `npm run dev` works without a database. It
# answers with fixture data and a sign-in that accepts any code, so a
# production build refuses to run with it on.
#
#   VITE_USE_MOCK=true   the mock answers — for development
#   VITE_USE_MOCK=false  the Java service answers — for anything real
VITE_USE_MOCK=true

# Where the Java service is, when the app is not served from the same host.
# In production this is a relative "/api", which is the default.
# VITE_API_URL=/api

# Where the dev server proxies /api to. Only used by `npm run dev`.
# VITE_API_TARGET=http://127.0.0.1:8080
