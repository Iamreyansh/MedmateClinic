{
  "name": "medmate-clinic-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "End-to-end suite for MedmateClinic: Playwright against the real stack (Postgres + Spring Boot + Vite, VITE_USE_MOCK=false).",
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:api": "playwright test --project=api",
    "e2e:routes": "playwright test --project=routes",
    "e2e:flows": "playwright test --project=flows",
    "report": "playwright show-report",
    "install:browser": "playwright install chromium --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
