# The API's environment.
#
# Every variable the service reads, with the value it takes when it is not
# set. Copy this file to .env and fill it in; nothing here is a secret except
# AUTH_SECRET, which must be replaced before the service runs outside a
# development machine.

# ---------------------------------------------------------------- the database
# The PostgreSQL server the API talks to.
DATABASE_URL=jdbc:postgresql://localhost:5432/medmate_clinic_api
DATABASE_USER=medmate
DATABASE_PASSWORD=medmate
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------------ the service
# The port the API listens on.
SERVER_PORT=8080
# The environment the service runs in: development | staging | production.
# It must be set. The service refuses to start without it, so a deployment
# cannot forget it and run with the test-mode sign-in turned on.
APP_ENV=development

# ---------------------------------------------------------------------- the auth
# The secret the session tokens are signed with. Replace it outside a
# development machine; the service refuses to start in production with the
# development secret.
AUTH_SECRET=change-me-to-a-long-random-string
# Whether the one-time code comes back in the API response. This is how a
# developer signs in without a phone, and it must be off outside development.
AUTH_EXPOSE_CODE=true
# How long a session lasts, in minutes.
AUTH_TTL_MINUTES=720
# How long a one-time code lasts, in minutes.
AUTH_OTP_TTL_MINUTES=5

# ------------------------------------------------------------------------- cors
# The browser origins the SPA is served from, comma separated. The SPA is on
# another origin than the API, so the API has to be told who may call it.
# "*" allows any origin.
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# --------------------------------------------------------------------- tenancy
# The schema the tenant directory lives in.
REGISTRY_SCHEMA=registry
# The prefix of every clinic's own schema.
CLINIC_SCHEMA_PREFIX=clinic_

# ------------------------------------------------------------------ the demo
# Whether the development clinic is given people, patients and a queue.
DEMO_ENABLED=false
# The clinic the demo data belongs to.
DEMO_CLINIC_ID=

# ---------------------------------------------------------------------- kiosk
# The clinic the kiosk is installed in. The kiosk belongs to one clinic, and
# the caller cannot point it at another.
KIOSK_CLINIC_SLUG=medmate-clinic
